AGENT_BACKEND=graph         # API: fake | graph (бейзлайн LangGraph); UI: fake | http (make ui-api)
API_URL=http://localhost:8000
LOG_LEVEL=INFO

LANGFUSE_TRACING_ENABLED=false
# LLM: fake (офлайн, без ключа) | openai_compat (kodikrouter / routerai / Ollama / vLLM)
LLM_PROVIDER=fake

# LLM_BASE_URL=https://api.kodikrouter.ru/v1     # запасной: https://routerai.ru/api/v1 ; Ollama: http://localhost:11434/v1
# LLM_API_KEY=                                     # ключ с лимитом бюджета; в git не коммитить
# LLM_MODEL=qwen/qwen3.6-35b-a3b                  # id из GET /v1/models
# LLM_EXTRA_BODY={"reasoning": {"enabled": false}}  # ОБЯЗАТЕЛЬНО для Qwen3.6: без него reasoning ×10 токенов, 5–6 с и битый JSON (проба 24.10)

# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com    # как в адресе твоего проекта
